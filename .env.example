# Copy to .env (git-ignored) and adjust. Every value below is the local
# development default; in Docker the same variables are set by
# docker-compose.yaml with service names instead of localhost.
POSTGRES_DSN=host=localhost user=myuser password=mypassword dbname=mydb port=5432 sslmode=disable search_path=order-service
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCER_TOPIC=order-service
# The order service follows the payment and shipment streams.
KAFKA_CONSUMER_TOPICS=payment-service,shipment-service
KAFKA_GROUP_ID=order-service
PORT=8080
LOGLEVEL=info
ALLOWED_ORIGINS=*
